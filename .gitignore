# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.superpowers
.worktrees/

# Native macOS app build artifacts
mac/build/
mac/build-debug/
mac/Overture.xcodeproj/xcuserdata/
mac/Overture.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/
*.xcuserstate

# Transient artifacts from Playwright MCP browser sessions (page snapshots, console logs)
.playwright-mcp/

# Last real eval-prep-runbook.sh run's failing fixtures, for `--yes --failed` rechecks (#1400)
.overture-eval-failures
# #1870: each real eval run's produced outputs, kept so a failure can be read instead of re-bought.
.overture-eval-runs/
# #1867: which runbook text the last COMPLETED eval scored, read by check-prep-eval-freshness.sh. Per
# machine by nature (it records what was run here), so it is never committed.
.overture-eval-last-run

# #2991: the last date each live-store invariant actually had rows to examine, so a run can say how
# LONG they have been dormant rather than only that they are. Per machine for the same reason as the
# line above, and the date lives inside the file rather than being its mtime, which a clone rewrites.
.overture-live-corpus-seen

# #3166: the local series of full suite runs (date, tests, suites, seconds, retry reason). Per machine,
# written by mac/scripts/run-tests-locked.sh, read only by its own advisory.
.overture-suite-run-series

# #1995: when the app-hosted tests (the only ones that render a real SwiftUI view) last passed HERE.
# Per machine for the same reason as the line above, and the date lives inside the file rather than
# being its mtime, which a clone rewrites.
.overture-hosted-suite-seen
# #3386: the main-actor share this machine last measured, for the same reason as the line above.
.overture-main-actor-share
