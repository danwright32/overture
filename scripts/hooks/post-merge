#!/usr/bin/env bash
# post-merge hook (#1251 Phase 3, installed per-clone by scripts/install-git-hooks.sh). After a merge that
# combined Mac source changes, regenerate mac/Overture.xcodeproj/project.pbxproj so the committed project
# file matches the merged tree. The Phase 2 spike (#1371) proved an in-driver regenerate silently DROPS a
# file (the path-order trap: git fires the driver before the other branch's new .swift is on disk), so
# this fires AFTER the merge, when every file is present.
#
# This is a CONVENIENCE, never the guarantee: check-pbxproj-fresh.sh (#1368) is the real gate, and this
# hook has a known hole (git does NOT run post-merge after a CONFLICTED merge finished by a manual commit),
# so nothing may rely on it having run. Degrade-safe: a silent no-op (exit 0) when xcodegen or mac/ is
# absent, so non-Overture uses of a shared clone, and CI, are unaffected.
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/mac-project-paths.sh
source "${HOOK_DIR}/../lib/mac-project-paths.sh"

# #1808: record what has shipped, BEFORE the xcodegen guards below, because those exit early on most
# merges and a pull that brings down new work is exactly when the app's idea of "what has shipped" needs
# updating. Reads origin/main, so it is correct whatever branch this merge landed on. Never fatal: a hook
# that fails a pull over a status file would be worse than the gap it closes.
if [ -x "${HOOK_DIR}/../record-shipped-commit.sh" ]; then
  "${HOOK_DIR}/../record-shipped-commit.sh" >/dev/null 2>&1 || true
fi

# Degrade-safe guards: only Overture clones with xcodegen do anything here.
command -v xcodegen >/dev/null 2>&1 || exit 0
[ -f mac/project.yml ] || exit 0

# Only when the merge actually touched the Mac project can it have changed the generated file.
CHANGED="$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || true)"
[ -n "$(paths_touch_mac_project "${CHANGED}")" ] || exit 0

( cd mac && xcodegen generate >/dev/null 2>&1 ) || exit 0

PBX="mac/Overture.xcodeproj/project.pbxproj"
# The merge already committed whatever project file git produced. If a fresh regen matches it, the merge
# was fine and there is nothing to do. If it differs, the merge left the project file stale.
if git diff --quiet -- "${PBX}"; then
  git checkout -- "${PBX}" 2>/dev/null || true
  exit 0
fi

git add -- "${PBX}"
echo "post-merge: this merge combined Mac source changes, so ${PBX} was out of date." >&2
echo "  It has been regenerated and STAGED. Commit it before pushing:" >&2
echo "      git commit -m 'Regenerate project.pbxproj after merge'" >&2
echo "  (Without this, check-pbxproj-fresh.sh blocks the next push or merge.)" >&2
exit 0
