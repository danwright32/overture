<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Overture</string>
	<key>CFBundleDisplayName</key>
	<string>Overture</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Dan Wright Photography</string>
	<!-- #1544: the ONE half of a cleartext permission the operating system enforces. The other half is
	     SourceFetcher.cleartextFallbackHosts, and CleartextFallbackTests fails if the two ever name
	     different sets. NSAllowsArbitraryLoads is deliberately absent: Dan's decision (2026-07-26) was to
	     name the single broken host rather than open cleartext everywhere and let app code be the only
	     gate, so every other source on the watchlist stays under the OS rule. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>dinumihailescu.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>Overture creates and updates follow-up tasks in OmniFocus so due reminders reach you when you're away from the app.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.danwright.overture.callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(OVERTURE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
