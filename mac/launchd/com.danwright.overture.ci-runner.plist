<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- User LaunchAgent that keeps an ephemeral self-hosted GitHub Actions runner listening
	     for this repo (Phase 2 of #478, docs/ci-runner-setup.md). Installed by
	     mac/scripts/register-ci-runner.sh and bootstrapped into the user's gui/$UID Aqua
	     session (NOT a system domain, NOT a LaunchDaemon): xcodebuild test's TEST_HOST is the
	     full Overture.app binary, which needs a GUI/Aqua session to run. A locked screen is
	     fine; Dan being logged in is what's required. New label, distinct from
	     com.danwright.overture (the app's own resident agent) so the two never collide. -->
	<key>Label</key>
	<string>com.danwright.overture.ci-runner</string>

	<!-- Points at the loop script (checked into the repo, run in place), not directly at the
	     runner's own run.sh: an --ephemeral runner deregisters and run.sh exits after exactly
	     one job, so something has to mint a fresh registration and reconfigure before every
	     job. register-ci-runner.sh bakes in the absolute path at install time (launchd does
	     not expand ~ or resolve a repo checkout on its own). -->
	<key>ProgramArguments</key>
	<array>
		<string>__CI_RUNNER_LOOP_SCRIPT__</string>
	</array>

	<!-- Start listening at login. -->
	<key>RunAtLoad</key>
	<true/>

	<!-- Unlike com.danwright.overture, the loop script is meant to run forever (it only exits
	     on a deliberate stop signal or a genuine setup problem), so an unexpected exit should
	     be restarted. ThrottleInterval still bounds restart frequency so a persistent problem
	     (e.g. a missing runner install) cannot become a tight respawn loop. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>

	<!-- A background launchd process does not inherit the PATH a shell profile sets up, so
	     xcodegen (needed by Phase 3's test job) and gh (needed to mint each job's registration
	     token) must be reachable explicitly. OVERTURE_CI_RUNNER_DIR and
	     OVERTURE_CI_RUNNER_LABEL keep the setup script and the loop script pointed at the same
	     install directory and runner label; register-ci-runner.sh bakes in the actual
	     directory it downloaded the runner into. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>OVERTURE_CI_RUNNER_DIR</key>
		<string>__CI_RUNNER_DIR__</string>
		<key>OVERTURE_CI_RUNNER_LABEL</key>
		<string>overture-mac</string>
	</dict>

	<!-- Same rationale as com.danwright.overture: owner-only (0700) directory under the
	     user's own ~/Library/Logs, not world-readable/reboot-cleared /tmp. Kept separate from
	     ~/Library/Logs/Overture so CI runner noise never mixes into the app's own diagnostics.
	     launchd does NOT expand ~, so register-ci-runner.sh substitutes the absolute path. -->
	<key>StandardOutPath</key>
	<string>__CI_RUNNER_LOG_DIR__/ci-runner-agent.out.log</string>
	<key>StandardErrorPath</key>
	<string>__CI_RUNNER_LOG_DIR__/ci-runner-agent.err.log</string>
</dict>
</plist>
